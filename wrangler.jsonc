{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Deployed with `bun run deploy --target <checkout>`, deliberately outside
  // the Alchemy stack: this Worker is a disposable proof of concept and must
  // never be able to touch a shared stage's state.
  "name": "swarm-review",
  "main": "worker.ts",
  "compatibility_date": "2026-08-30",
  // Comma-separated allowed clone URLs, deliberately unset here. A Worker
  // without the allowlist refuses every run. Set it at deployment.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "PROBE_RESULTS", "bucket_name": "swarm-review-probes" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REVIEW_SANDBOX", "class_name": "ReviewSandbox" },
      { "name": "REVIEW_JOBS", "class_name": "ReviewJob" },
      { "name": "PULL_REQUEST_REVIEWS", "class_name": "PullRequestReview" },
      { "name": "CREDENTIAL_VAULT", "class_name": "CredentialVaultObject" },
      { "name": "CODEX_RELAY", "class_name": "CodexRelaySandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReviewSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["CredentialVaultObject"] },
    { "tag": "v3", "new_sqlite_classes": ["CodexRelaySandbox"] },
    { "tag": "v4", "new_sqlite_classes": ["ReviewJob"] },
    { "tag": "v5", "new_sqlite_classes": ["PullRequestReview"] }
  ],
  "containers": [
    {
      "class_name": "ReviewSandbox",
      "image": "./container/Dockerfile",
      // This directory, whose `context/` subdirectory the deploy script fills
      // with the target checkout's manifests; the image bakes the Bun cache for
      // their lockfile from there.
      "image_build_context": "container",
      // A monorepo checkout plus its node_modules plus a build cache does not
      // fit anything smaller, and the install is the long pole of a cold run.
      "instance_type": "standard-4",
      // A swarm holds one container per concurrent sandbox lane, and a lane's
      // container outlives its own teardown for long enough to overlap the
      // next. At the exact lane count the surplus lane's sandbox dies
      // mid-review with a 500, so the ceiling is the lanes of every swarm that
      // may run at once plus room for that overlap: ten hybrid swarms of three
      // verifiers each, which is what an eval wave runs in parallel. The
      // account allows 1500 vCPU; this is 120.
      "max_instances": 30
    },
    {
      "class_name": "CodexRelaySandbox",
      "image": "./relay/Dockerfile",
      "image_build_context": "relay",
      "instance_type": "lite",
      "max_instances": 1
    }
  ]
}
