{
  "name": "swarm-review",
  "version": "0.0.0",
  "description": "Disposable Cloudflare Sandbox proof of concept: one throwaway container clones the whole monorepo at pinned PR SHAs, installs it, and lets one Pi model review the diff while running real checks.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "clean": "git clean -xdf .cache dist node_modules",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "biome": "biome check .",
    "lint": "oxlint .",
    "deploy": "bun run scripts/deploy.ts",
    "create-app": "bun run scripts/create-app.ts",
    "poc:teardown": "wrangler delete --force",
    "review:local": "bun run src/local.ts",
    "review:eval": "bun run evals/run.ts",
    "review:swarm": "bun run src/swarm.ts",
    "review:publish": "bun run src/publish.ts"
  },
  "dependencies": {
    "@cgaravitoq/claude-code-core": "0.3.1",
    "@cloudflare/sandbox": "0.12.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "5.20260923.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "^2.1.14",
    "oxlint": "1.85.0",
    "secretlint": "^13.0.5",
    "typescript": "^6.0.3",
    "ultracite": "7.12.0",
    "vitest": "^4.1.11",
    "wrangler": "4.136.3"
  }
}
